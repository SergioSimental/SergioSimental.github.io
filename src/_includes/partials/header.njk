{%- set navLinks = [
  { label: "Resume", href: "/" },
  { label: "Projects", href: "/projects/" }
] -%}
<header class="site-header">
  <nav class="site-nav container" aria-label="Primary">
    <a class="site-nav__brand" href="/">{{ site.handle }}<span class="accent">_</span></a>

    {#- Visible on every screen size: with two pages there's nothing to hide behind a menu. #}
    <ul class="site-nav__links">
      {%- for link in navLinks %}
      <li><a href="{{ link.href }}"{% if page.url == link.href %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
      {%- endfor %}
    </ul>

    <ul class="site-nav__social">
      <li><a href="{{ site.github }}" aria-label="GitHub">{% include "partials/icon-github.njk" %}</a></li>
      <li><a href="{{ site.linkedin }}" aria-label="LinkedIn">{% include "partials/icon-linkedin.njk" %}</a></li>
    </ul>

    <a class="btn btn--primary btn--sm site-nav__pdf" href="{{ site.resumePdf }}" aria-label="Download resume (PDF)">
      {% include "partials/icon-download.njk" %}<span class="site-nav__pdf-label">PDF</span>
    </a>
  </nav>
</header>
