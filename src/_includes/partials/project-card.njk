{#- Renders one project. Expects `project` (a project file's front matter). -#}
{%- set media = project.media or {} -%}
{%- set descId = "demo-desc-" + (project.title | slugify) -%}
<article class="project-card{% if project.featured %} project-card--featured{% endif %}">
  <div class="project-card__media" style="--media-bg: {{ media.background or '#1A1D22' }}; --video-bg: {{ media.videoBackground or '#000' }}"
       {%- if media.video %} data-demo="{{ media.video | url }}" data-demo-label="{{ project.title }} demo video"{% if media.videoDescription %} data-demo-desc="{{ descId }}"{% endif %}{% endif %}>
    {%- if media.kind == "board" %}
    <div class="board" role="img" aria-label="{{ media.alt }}" style="--rows: {{ media.rows or 8 }}; --cols: {{ media.cols or 8 }}">
      {%- for cell in media.pieces | boardCells(media.rows or 8, media.cols or 8) %}<span class="board__cell{% if cell %} board__cell--{{ cell }}{% endif %}"></span>{% endfor %}
    </div>
    {%- else %}
    <img src="{{ media.src }}" alt="{{ media.alt }}"
      sizes="{% if project.featured %}(min-width: 1200px) 680px, (min-width: 760px) 58vw, 100vw{% else %}(min-width: 1200px) 570px, (min-width: 980px) 48vw, 100vw{% endif %}"
      {%- if media.position %} style="object-position: {{ media.position }}"{% endif %}>
    {%- endif %}

    {%- if media.video %}
    <button class="play-button" type="button" data-demo-play{% if media.videoDescription %} aria-describedby="{{ descId }}"{% endif %}>
      <span class="play-button__pill">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
        Play demo{% if media.duration %} · {{ media.duration }}{% endif %}<span class="sr-only">, {{ project.title }}</span>
      </span>
    </button>
    <noscript><a class="play-button" href="{{ media.video }}"><span class="play-button__pill">Watch demo</span></a></noscript>
    {%- endif %}

    {%- if project.badge %}<span class="project-card__badge">{{ project.badge }}</span>{% endif %}
  </div>
  {%- if media.video and media.videoDescription %}
  <p class="sr-only" id="{{ descId }}">Silent video: {{ media.videoDescription }}</p>
  {%- endif %}

  <div class="project-card__body">
    {%- if project.featured %}<span class="eyebrow">Featured</span>{% endif %}
    <h2 class="project-card__title">{{ project.title }}</h2>
    <p class="project-card__summary">{{ project.summary }}</p>

    {%- if project.highlights and project.highlights.length %}
    <ul class="project-card__highlights" aria-label="Highlights">
      {%- for item in project.highlights %}<li>{{ item }}</li>{% endfor %}
    </ul>
    {%- endif %}

    {%- if project.tech and project.tech.length %}
    <ul class="chips" aria-label="Technologies">
      {%- for t in project.tech %}<li class="chip chip--mono">{{ t }}</li>{% endfor %}
    </ul>
    {%- endif %}

    <div class="project-card__links">
      {%- for link in project.links %}
      {%- if link.primary %}
      <a class="btn btn--primary" href="{{ link.href }}">{{ link.label }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg></a>
      {%- else %}
      <a class="text-link" href="{{ link.href }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>{{ link.label }}</a>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</article>
